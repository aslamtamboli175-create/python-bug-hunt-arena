{
  "name": "python-bug-hunt-arena",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
